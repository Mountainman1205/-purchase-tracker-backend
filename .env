# Токен вашего бота от @BotFather
BOT_TOKEN=123456:AAExampleTokenHere

# Для локальной разработки без реального Telegram-клиента:
# ставит DEV_MODE=1, чтобы не проверять initData, а использовать тестового юзера
DEV_MODE=1

# По умолчанию используется SQLite (файл tracker.db).
# Для продакшена на Railway/Render раскомментируйте и впишите свою строку:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
